rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /premiumRegistrationClaims/{id} {
      allow read, write: if false;
    }
    match /premiumRegistrationPermits/{id} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
